# =============================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO  —  Proyecto GMAO
# =============================================================================
#
#  CÓMO SE USA
#  -----------
#    1. Copia este fichero:      cp .env.example .env.local
#    2. Rellena los valores reales en .env.local
#    3. Reinicia el servidor:    npm run dev
#
#  `.env.local` está ignorado por git (ver .gitignore) y NUNCA debe subirse.
#  Este `.env.example` sí se sube: documenta qué configuración hace falta,
#  pero sin valores reales.
#
#  DÓNDE SE ENCUENTRAN ESTOS VALORES
#  ---------------------------------
#  Panel de Supabase → tu proyecto → Project Settings → API
#
# =============================================================================


# -----------------------------------------------------------------------------
# PÚBLICAS  (el prefijo NEXT_PUBLIC_ las incrusta en el JS del navegador)
# -----------------------------------------------------------------------------

# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anónima (`anon` / `publishable`).
# Es PÚBLICA por diseño y no es un secreto: por sí sola no da acceso a nada.
# Quien decide qué puede leer o escribir cada usuario son las políticas RLS
# (Row Level Security) que definiremos en la Fase 3. Sin RLS activado, esta
# clave sí abriría la base de datos entera: no se nos puede olvidar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...


# -----------------------------------------------------------------------------
# PRIVADAS  (SOLO servidor — jamás con prefijo NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Clave `service_role`. IGNORA todas las políticas RLS: quien la tiene puede
# leer y escribir CUALQUIER fila de CUALQUIER tabla.
#
# Uso previsto en este proyecto: los scripts de importación de los volcados de
# SAP PM (Fase 3), que necesitan escribir el maestro de materiales completo
# saltándose las restricciones por usuario.
#
# Si esta clave acaba en el navegador, la base de datos queda expuesta por
# completo. No se usa en ningún componente. No se pega en ningún chat.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
